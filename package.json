{
  "name": "ghost-prompt",
  "displayName": "GhostPrompt",
  "description": "Ghost-text completions for your Copilot prompts — write faster, think clearer.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ghostPrompt",
          "title": "GhostPrompt",
          "icon": "media/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "ghostPromptPanel",
          "title": "GhostPrompt",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "ghostPrompt": [
        {
          "type": "webview",
          "id": "ghostPrompt.input",
          "name": "GhostPrompt",
          "when": "true"
        }
      ],
      "ghostPromptPanel": [
        {
          "type": "webview",
          "id": "ghostPrompt.inputPanel",
          "name": "GhostPrompt",
          "when": "true"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "validate": "npm run lint && npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
