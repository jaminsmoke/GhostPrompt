.vscode-test-profile/**
lint-report.json
lint*.txt
lint*.json
.eslint-report.json
tmp-*.txt
tmp-*.json
tsconfig.eslint.json
*.vsix

# Build-only artifacts
scripts/**
Scripts/**
eslint/**
out/system/build/**

# Exclude source tree; keep webview bundle assets only
src/**
!src/ui/webview/dist/
!src/ui/webview/dist/**

# Test sources
tests/**
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

